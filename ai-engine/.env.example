# Copy to .env (never commit .env). Set these in the shell before starting the server.

# OpenAI (default): leave OPENAI_BASE_URL unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Reasoning off for reasoning models. Leave empty for models that reject this parameter (e.g. gpt-4o-mini).
OPENAI_REASONING_EFFORT=none

# Gemma on RunPod (vLLM, OpenAI-compatible): set these instead.
# OPENAI_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# OPENAI_MODEL=google/gemma-3-27b-it
# OPENAI_API_KEY=            # empty is fine unless vLLM was started with --api-key

# Optional: path to the experiment CSV used by /ask
# DATASET_PATH=../dataset-psi/merged_psi_combustion_v2.csv
